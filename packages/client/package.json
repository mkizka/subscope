{
  "name": "@repo/client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./api": {
      "import": "./dist/api.js",
      "types": "./dist/api.d.ts"
    },
    "./lex": {
      "import": "./dist/lex.js",
      "types": "./dist/lex.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    }
  },
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "generate": "./scripts/generate.sh",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/api": "0.29.5",
    "@atproto/lex": "0.4.2",
    "@atproto/lex-server": "0.2.0",
    "@atproto/lexicon": "0.7.17",
    "@atproto/oauth-client": "0.9.0",
    "@atproto/xrpc": "0.8.16",
    "@atproto/xrpc-server": "0.13.6",
    "multiformats": "14.0.5"
  },
  "devDependencies": {
    "@atproto/lex-cli": "0.10.16",
    "@mkizka/eslint-config": "10.0.0",
    "@tsconfig/node-lts": "24.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "giget": "3.3.1",
    "typescript": "6.0.3"
  },
  "sideEffects": false
}
