{
  "name": "@repo/client",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./lex/*": {
      "import": "./dist/generated/*.js",
      "types": "./dist/generated/*.d.ts"
    }
  },
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "build": "tsc",
    "dev": "tsc --watch",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "generate": "./scripts/generate.sh",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/lex": "0.4.2"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "24.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  },
  "sideEffects": false
}
