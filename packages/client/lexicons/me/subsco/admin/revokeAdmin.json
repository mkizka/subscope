{
  "lexicon": 1,
  "id": "me.subsco.admin.revokeAdmin",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke admin from a registered account",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "did": {
              "type": "string",
              "format": "did",
              "description": "The DID of the registered account to revoke admin"
            }
          },
          "required": ["did"]
        }
      },
      "errors": [
        {
          "name": "AdminRequired"
        },
        {
          "name": "NotRegistered"
        },
        {
          "name": "CannotRevokeSelf"
        }
      ]
    }
  }
}
