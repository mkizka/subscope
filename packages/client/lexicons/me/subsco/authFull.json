      "permissions": [
        {
          "type": "permission",
          "resource": "rpc",
          "inheritAud": true,
          "lxm": [
            "me.subsco.admin.banAccount",
            "me.subsco.admin.createInviteCode",
            "me.subsco.admin.deleteInviteCode",
            "me.subsco.admin.getBannedAccounts",
            "me.subsco.admin.getInviteCodes",
            "me.subsco.admin.grantAdmin",
