{
  "lexicon": 1,
  "id": "me.subsco.sync.getRegistrationStatus",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the registration status for the authenticated user",
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "union",
          "refs": ["#member", "#notMember"]
        }
      }
    },
    "member": {
      "type": "object",
      "required": ["isMember"],
      "properties": {
        "isMember": {
          "type": "boolean",
          "const": true,
          "description": "The user is a member"
        }
      }
    },
    "notMember": {
      "type": "object",
      "required": ["isMember"],
      "properties": {
        "isMember": {
          "type": "boolean",
          "const": false,
          "description": "The user is not a member"
        }
      }
    }
  }
}
