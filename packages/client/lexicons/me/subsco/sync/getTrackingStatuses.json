{
  "lexicon": 1,
  "id": "me.subsco.sync.getTrackingStatuses",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get whether each tracked account is a member and its backfill status. Accounts that are not tracked are omitted.",
      "parameters": {
        "type": "params",
        "required": ["dids"],
        "properties": {
          "dids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "did"
            },
            "maxLength": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["statuses"],
          "properties": {
            "statuses": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#trackingStatus"
              }
            }
          }
        }
      }
    },
    "trackingStatus": {
      "type": "object",
      "required": ["did", "isMember", "backfillStatus"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "isMember": {
          "type": "boolean"
        },
        "backfillStatus": {
          "type": "string",
          "knownValues": ["inProgress", "completed", "error"]
        }
      }
    }
  }
}
