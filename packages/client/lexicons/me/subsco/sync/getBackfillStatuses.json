{
  "lexicon": 1,
  "id": "me.subsco.sync.getBackfillStatuses",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the backfill status of tracked accounts. Accounts that are not tracked are omitted.",
      "parameters": {
        "type": "params",
        "required": ["dids"],
        "properties": {
          "dids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "did"
            },
            "maxLength": 100
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["statuses"],
          "properties": {
            "statuses": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#backfillStatus"
              }
            }
          }
        }
      }
    },
    "backfillStatus": {
      "type": "object",
      "required": ["did", "status"],
      "properties": {
        "did": {
          "type": "string",
          "format": "did"
        },
        "status": {
          "type": "string",
          "knownValues": ["inProgress", "completed", "error"]
        }
      }
    }
  }
}
