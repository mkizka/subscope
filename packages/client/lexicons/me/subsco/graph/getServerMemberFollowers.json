{
  "lexicon": 1,
  "id": "me.subsco.graph.getServerMemberFollowers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get the registered accounts that follow the given account.",
      "parameters": {
        "type": "params",
        "required": ["actor"],
        "properties": {
          "actor": {
            "type": "string",
            "format": "at-identifier"
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["total", "followers"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer"
            },
            "followers": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "app.bsky.actor.defs#profileView"
              }
            }
          }
        }
      }
    }
  }
}
