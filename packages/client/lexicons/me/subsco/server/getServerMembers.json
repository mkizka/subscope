{
  "lexicon": 1,
  "id": "me.subsco.server.getServerMembers",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get a list of registered accounts profiles.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          },
          "q": {
            "type": "string",
            "description": "Filter accounts whose display name or handle contains this text."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["serverMembers"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "serverMembers": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#serverMember"
              }
            }
          }
        }
      }
    },
    "serverMember": {
      "type": "object",
      "required": ["profile", "isAdmin"],
      "properties": {
        "profile": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileView"
        },
        "isAdmin": {
          "type": "boolean"
        }
      }
    }
  }
}
