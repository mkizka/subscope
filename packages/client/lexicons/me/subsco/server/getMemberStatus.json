        "type": "params",
        "required": ["did"],
        "properties": {
          "did": {
            "type": "string",
            "format": "did"
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["isMember"],
          "properties": {
            "isMember": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
