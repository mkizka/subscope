{
  "lexicon": 1,
  "id": "me.subsco.server.getFollowedAccounts",
  "defs": {
    "main": {
      "type": "query",
      "description": "Get accounts followed by at least one member, ordered by the number of members following them.",
      "parameters": {
        "type": "params",
        "properties": {
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": {
            "type": "string"
          },
          "q": {
            "type": "string",
            "description": "Filter accounts whose display name or handle contains this text."
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["followedAccounts", "total"],
          "properties": {
            "cursor": {
              "type": "string"
            },
            "total": {
              "type": "integer"
            },
            "followedAccounts": {
              "type": "array",
              "items": {
                "type": "ref",
                "ref": "#followedAccount"
              }
            }
          }
        }
      }
    },
    "followedAccount": {
      "type": "object",
      "required": ["profile", "registeredFollowersCount"],
      "properties": {
        "profile": {
          "type": "ref",
          "ref": "app.bsky.actor.defs#profileView"
        },
        "registeredFollowersCount": {
          "type": "integer"
        }
      }
    }
  }
}
