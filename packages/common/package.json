{
  "name": "@repo/common",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./utils": "./src/utils.js",
    "./domain": "./src/domain.js",
    "./infrastructure": "./src/infrastructure.js",
    "./test": "./src/test.js"
  },
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/did": "0.5.6",
    "@atproto/identity": "0.5.20",
    "@atproto/lexicon": "0.7.17",
    "@atproto/syntax": "0.7.7",
    "@atproto/tap": "0.4.16",
    "@keyv/redis": "6.1.0",
    "@repo/client": "workspace:*",
    "@repo/db": "workspace:*",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "ioredis": "5.11.1",
    "keyv": "6.1.0",
    "multiformats": "14.0.5",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3"
  },
  "devDependencies": {
    "@faker-js/faker": "10.6.0",
    "@mkizka/eslint-config": "10.0.0",
    "@repo/vitest": "workspace:*",
    "@tsconfig/node-lts": "24.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  },
  "sideEffects": false
}
