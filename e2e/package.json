{
  "name": "@repo/e2e",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../.gitignore --cache --log-level warn",
    "e2e": "playwright test",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@repo/eslint-config": "workspace:*",
    "@tsconfig/node-lts": "24.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  }
}
