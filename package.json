{
  "name": "@repo/workspace",
  "version": "1.0.0",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "_prettier": "prettier --ignore-path .prettier --ignore-path .gitignore",
    "all": "turbo run typecheck format && vitest run",
    "all:unit": "turbo run typecheck format && pnpm test:unit run",
    "build": "turbo run build",
    "db:generate": "pnpm --filter @repo/db db:generate",
    "db:migrate": "pnpm --filter @repo/db db:migrate",
    "dev": "node --import tsx ./dev-env/server.mts pnpm turbo run dev --ui tui",
    "format": "pnpm -s run _prettier . --write && turbo run format",
    "get-docs": "./scripts/get-docs.sh",
    "lint": "pnpm -s run _prettier . --check && turbo run lint",
    "prepare": "husky",
    "storybook": "pnpm --filter @repo/web storybook",
    "test": "vitest",
    "test:unit": "vitest --project *:unit",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@atproto/dev-env": "0.6.24",
    "@testcontainers/postgresql": "12.2.1",
    "@vitest/coverage-v8": "5.0.5",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-pkg": "0.22.1",
    "prettier-plugin-sh": "0.20.2",
    "repomix": "1.18.1",
    "testcontainers": "12.2.1",
    "tsx": "4.23.15",
    "turbo": "2.11.10",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*": "pnpm -s run _prettier --ignore-unknown --write"
  },
  "prettier": {
    "plugins": [
      "prettier-plugin-pkg",
      "prettier-plugin-sh"
    ]
  }
}
