{
  "name": "@repo/ingester",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "dev": "NODE_ENV=development tsx watch ./src/ingester.ts | pino-pretty",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "start": "NODE_ENV=production tsx ./src/ingester.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/did": "0.5.6",
    "@atproto/lex": "0.4.2",
    "@atproto/tap": "0.4.16",
    "@atproto/xrpc-server": "0.13.6",
    "@gyaku/di": "5.0.0",
    "@keyv/redis": "6.1.0",
    "@repo/client": "workspace:*",
    "@repo/common": "workspace:*",
    "express": "5.3.0",
    "keyv": "6.1.0",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@mkizka/eslint-config": "10.0.0",
    "@tsconfig/node-lts": "24.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3"
  }
}
