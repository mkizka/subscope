{
  "name": "@repo/web",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "build": "react-router build",
    "build-storybook": "storybook build",
    "dev": "react-router dev | pino-pretty",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "preview": "vite preview",
    "start": "node server.js",
    "storybook": "storybook dev -p 6006",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@atproto/api": "0.29.5",
    "@atproto/common-web": "0.5.15",
    "@atproto/jwk-jose": "0.2.4",
