    "@repo/eslint-config": "workspace:*",
    "@storybook/react-vite": "10.6.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.13.0",
    "eslint-plugin-better-tailwindcss": "4.10.0",
    "eslint-plugin-storybook": "10.6.4",
    "pino-pretty": "13.2.0",
    "storybook": "10.6.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
