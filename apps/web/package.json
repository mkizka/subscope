    "@atproto/oauth-client-node": "0.5.13",
    "@atproto/syntax": "0.7.7",
    "@bull-board/api": "7.2.1",
    "@conform-to/react": "1.21.2",
    "@conform-to/zod": "1.21.2",
    "@fontsource/zen-maru-gothic": "5.3.1",
    "@gyaku/di": "5.0.0",
    "@react-router/express": "8.5.0",
    "@react-router/fs-routes": "8.5.0",
    "@react-router/node": "8.5.0",
    "@repo/client": "workspace:*",
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "@tanstack/react-query": "5.105.0",
    "bull-board-react-router": "1.1.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "isbot": "5.2.2",
    "lucide-react": "1.62.0",
    "morgan": "1.12.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.0",
    "yet-another-react-lightbox": "3.33.0",
    "zod-validation-error": "5.0.0",
    "zodV4": "npm:zod@4.6.7"
