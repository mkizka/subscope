{
  "name": "@repo/worker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "main": "dist/worker.js",
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "build": "node build.ts",
    "dev": "NODE_ENV=development tsx watch ./src/worker.ts | pino-pretty",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "start": "NODE_ENV=production node dist/worker.js",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/did": "0.5.6",
    "@atproto/identity": "0.5.24",
    "@atproto/lex": "0.6.0",
    "@atproto/repo": "0.11.6",
    "@atproto/syntax": "0.7.8",
    "@atproto/tap": "0.4.21",
    "@atproto/xrpc-server": "0.13.14",
    "@gyaku/di": "5.0.0",
    "@repo/client": "workspace:*",
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "bullmq": "6.7.8",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-prom-bundle": "8.0.0",
    "ioredis": "5.11.1",
    "keyv": "6.1.0",
    "prom-client": "15.1.3",
    "web-push": "4.0.0",
    "ws": "8.23.0",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/test-utils": "workspace:*",
    "@repo/vitest": "workspace:*",
    "@repo/web-push-mock": "workspace:*",
    "@tsconfig/node-lts": "26.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "@types/web-push": "3.6.4",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
