{
  "name": "@repo/worker",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "_eslint": "eslint --cache --cache-location ./node_modules/.cache/eslint",
    "_prettier": "prettier . --ignore-path ../../.gitignore --cache --log-level warn",
    "dev": "NODE_ENV=development tsx watch ./src/worker.ts | pino-pretty",
    "format": "pnpm -s run _eslint --fix && pnpm -s run _prettier --ignore-unknown --write",
    "lint": "pnpm -s run _eslint && pnpm -s run _prettier --check",
    "start": "NODE_ENV=production tsx ./src/worker.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@atproto/did": "0.5.6",
    "@atproto/identity": "0.5.20",
    "@atproto/lexicon": "0.7.17",
    "@atproto/repo": "0.11.1",
    "@atproto/syntax": "0.7.7",
    "@gyaku/di": "5.0.0",
    "@repo/client": "workspace:*",
    "@repo/common": "workspace:*",
    "@repo/db": "workspace:*",
    "bullmq": "6.5.0",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "express-prom-bundle": "8.0.0",
    "ioredis": "5.11.1",
    "prom-client": "15.1.3",
    "tsx": "4.23.15",
    "ws": "8.22.0",
    "zod": "4.6.7",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@mkizka/eslint-config": "10.0.0",
    "@repo/test-utils": "workspace:*",
    "@repo/vitest": "workspace:*",
    "@tsconfig/node-lts": "24.0.1",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "eslint": "10.13.0",
    "pino-pretty": "13.2.0",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "vitest-mock-extended": "5.1.1"
  }
}
